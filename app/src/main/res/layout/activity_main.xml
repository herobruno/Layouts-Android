<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F2F4F8">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Comparativo de Layouts"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#212121"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Exemplo 1: ConstraintLayout -->
        <include layout="@layout/activity_constraint" />

        <!-- Exemplo 2: RelativeLayout -->
        <include layout="@layout/activity_relative" />

        <!-- Exemplo 3: TableLayout -->
        <include layout="@layout/activity_table" />

        <!-- Exemplo 4: LinearLayout -->
        <include layout="@layout/activity_linear_demo" />

    </LinearLayout>
</ScrollView>