<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:background="#FFFFFF"
    android:layout_marginBottom="16dp"
    android:elevation="2dp">

    <!-- Title showing why RelativeLayout is used -->
    <TextView
        android:id="@+id/tvRelTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RelativeLayout (Card de Produto)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#E8710A" />

    <TextView
        android:id="@+id/tvRelDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ideal para posicionar elementos em relação uns aos outros e às bordas do pai."
        android:textSize="12sp"
        android:textColor="#5F6368"
        android:layout_below="@id/tvRelTitle"
        android:layout_marginBottom="16dp" />

    <!-- Simulated Image / Banner container -->
    <View
        android:id="@+id/vProductBanner"
        android:layout_width="match_parent"
        android:layout_height="150dp"
        android:background="#E8F0FE"
        android:layout_below="@id/tvRelDesc"
        android:layout_marginBottom="12dp" />

    <!-- Badge positioned at top end of the banner (RelativeLayout feature) -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=" 30% OFF "
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold"
        android:background="#EA4335"
        android:padding="6dp"
        android:layout_alignTop="@id/vProductBanner"
        android:layout_alignParentEnd="true"
        android:layout_margin="12dp" />

    <!-- Product Title below banner -->
    <TextView
        android:id="@+id/tvProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Fone de Ouvido Bluetooth Pro"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="#202124"
        android:layout_below="@id/vProductBanner" />

    <!-- Price aligned left below title -->
    <TextView
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="R$ 199,90"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#137333"
        android:layout_below="@id/tvProductName"
        android:layout_marginTop="8dp" />

    <!-- Buy Button aligned right below title/price (RelativeLayout feature) -->
    <Button
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Comprar"
        android:backgroundTint="#1A73E8"
        android:layout_below="@id/tvProductName"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="4dp" />

</RelativeLayout>
