<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp"
    android:stretchColumns="1"
    android:background="#FFFFFF"
    android:layout_marginBottom="16dp"
    android:elevation="2dp">

    <!-- Title showing why TableLayout is used -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TableLayout (Extrato Financeiro)"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#137333"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ideal para organizar dados tabulares estritos em linhas (TableRow) e colunas."
        android:textSize="12sp"
        android:textColor="#5F6368"
        android:layout_marginBottom="16dp" />

    <!-- Table Header Row -->
    <TableRow
        android:background="#F1F3F4"
        android:padding="8dp">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Data"
            android:textStyle="bold"
            android:textColor="#202124"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Descrição"
            android:textStyle="bold"
            android:textColor="#202124"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Valor"
            android:textStyle="bold"
            android:textColor="#202124"
            android:gravity="end"
            android:padding="6dp" />
    </TableRow>

    <!-- Table Data Row 1 -->
    <TableRow
        android:padding="8dp"
        android:background="#FFFFFF">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03/09"
            android:textColor="#5F6368"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Supermercado"
            android:textColor="#202124"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- R$ 150,00"
            android:textColor="#EA4335"
            android:gravity="end"
            android:padding="6dp" />
    </TableRow>

    <!-- Table Data Row 2 -->
    <TableRow
        android:padding="8dp"
        android:background="#F8F9FA">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="02/09"
            android:textColor="#5F6368"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Salário"
            android:textColor="#202124"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ R$ 3.500,00"
            android:textColor="#137333"
            android:gravity="end"
            android:padding="6dp" />
    </TableRow>

    <!-- Table Data Row 3 -->
    <TableRow
        android:padding="8dp"
        android:background="#FFFFFF">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="01/09"
            android:textColor="#5F6368"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Internet"
            android:textColor="#202124"
            android:padding="6dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="- R$ 100,00"
            android:textColor="#EA4335"
            android:gravity="end"
            android:padding="6dp" />
    </TableRow>

</TableLayout>
